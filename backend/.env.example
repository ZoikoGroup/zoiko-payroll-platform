# ── Zoiko Payroll Platform — environment template ─────────────────────────
# Copy to .env and fill in. All values here are safe development defaults.
#
#   copy .env.example .env        (PowerShell)
#   cp .env.example .env          (bash)

# ── Database ──────────────────────────────────────────────────────────────
# Own database, separate from the main platform. Leave empty in development
# to use the SQLite fallback at app/data/payroll_dev.sqlite3.
PAYROLL_DATABASE_URL=

# Example (PostgreSQL):
# PAYROLL_DATABASE_URL=postgresql+psycopg://payroll_user:change-me@localhost:5432/zoiko_payroll

# ── JWT / Auth (own secret — never reuse the main platform's) ────────────
PAYROLL_SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
JWT_ISSUER=zoiko-payroll-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App Info ──────────────────────────────────────────────────────────────
APP_NAME=Zoiko Payroll Platform Backend
APP_VERSION=1.0.0
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
PAYROLL_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public-facing frontend URL (used in "Send Template" form-fill emails).
FRONTEND_URL=http://localhost:5173

# ── Email / SMTP (shared platform connection) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@payroll.zoiko.example
SMTP_USE_TLS=true

# ── Payroll Leave-Request Mail Receiver (IMAP) ────────────────────────────
# Optional per-org inbound mailbox. The shared-platform defaults below are
# used only where an org has not supplied its own.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
PAYROLL_MAIL_POLL_INTERVAL_MINUTES=15

# ── Super Admin setup key ─────────────────────────────────────────────────
# Required to run scripts/seed_super_admin.py. Keep secret.
SETUP_KEY=