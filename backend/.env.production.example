# -- Zoiko Payroll Platform -- PRODUCTION environment template --------------
# Copy to backend/.env on the production VM and fill in with real values.
# Never commit the filled-in file -- backend/.env is gitignored.
#
#   cp .env.production.example .env        (bash, on the VM)

# -- Database (production: PostgreSQL REQUIRED -- no SQLite fallback) -------
# If left empty while DEBUG=false, the app fails closed at startup rather
# than silently writing to an ephemeral SQLite file.
PAYROLL_DATABASE_URL=

# -- JWT / Auth (generate a fresh random secret -- never reuse dev) ---------
PAYROLL_SECRET_KEY=
ALGORITHM=HS256
JWT_ISSUER=zoiko-payroll-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- App Info ----------------------------------------------------------------
APP_NAME=Zoiko Payroll Platform Backend
APP_VERSION=1.0.0
DEBUG=false

# -- Error tracking (Sentry) -------------------------------------------------
SENTRY_DSN=

# -- CORS --------------------------------------------------------------------
# Exact production frontend origin(s), comma-separated. Same-origin is
# recommended (nginx proxies /api/* and /* under one domain), which keeps
# this list minimal.
PAYROLL_CORS_ORIGINS=https://payroll.zoiko.example

# Public-facing frontend URL (used in emailed invite/reset/form-fill links).
FRONTEND_URL=https://payroll.zoiko.example

# -- Email / SMTP -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@payroll.zoiko.example
SMTP_USE_TLS=true

# -- Payroll Leave-Request Mail Receiver (IMAP) ------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
PAYROLL_MAIL_POLL_INTERVAL_MINUTES=15

# -- Super Admin setup key ----------------------------------------------------
# Required one-off for scripts/seed_super_admin.py. Rotate/restrict after
# the first Super Admin is seeded.
SETUP_KEY=

# -- Object storage (GCS) ------------------------------------------------------
# Required in production so uploads (compliance docs, org logos) go to Cloud
# Storage instead of ephemeral VM disk. Storage backend auto-selects GCS
# whenever PAYROLL_GCS_BUCKET is set.
PAYROLL_GCS_BUCKET=
# PAYROLL_GCS_UPLOAD_PREFIX=prod
# PAYROLL_STORAGE_BACKEND=auto

# -- Zoiko Payroll Assist ----------------------------------------------------
ASSIST_SUPPORT_EMAIL=
ASSIST_SWEEP_ENABLED=true
ASSIST_SWEEP_INTERVAL_HOURS=24
ASSIST_KILL_SWITCH_ENABLED=false

# Optional LLM gateway (leave empty/disabled for deterministic-only):
# ASSIST_MODEL_PROVIDER=openai-compatible
# ASSIST_MODEL_BASE_URL=
# ASSIST_MODEL_NAME=
# ASSIST_MODEL_API_KEY=
# ASSIST_MODEL_TIMEOUT_SECONDS=30