.git
.gitignore
.env
.env.*
!.env.example
# Every folder, not just the root: frontend/.env would otherwise be copied
# into the image and compiled into the bundle.
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
__pycache__
*.pyc
*.pyo
.venv/
venv/
node_modules/
frontend/dist/
frontend/node_modules/
backend/.venv/
backend/data/
*.sqlite3
*.db
docs/
README.md
.dockerignore
docker-compose.yml
