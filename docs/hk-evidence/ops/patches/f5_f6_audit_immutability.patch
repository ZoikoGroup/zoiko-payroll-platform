diff --git a/backend/app/core/audit_immutability.py b/backend/app/core/audit_immutability.py
new file mode 100644
index 0000000..37b7757
--- /dev/null
+++ b/backend/app/core/audit_immutability.py
@@ -0,0 +1,75 @@
+"""
+G5 F-6: audit rows are append-only at the database level.
+
+PostgreSQL: migration d1e5a7c3b9f2 installs zoiko_reject_audit_mutation() and a
+BEFORE UPDATE OR DELETE trigger on every table in AUDIT_TABLES. SQLite (tests):
+the same rule is installed after `metadata.create_all` (listener below), so the
+unit suite enforces it too.
+
+The only way to remove audit rows is an explicit, logged purge scope
+(`audit_purge_scope`): PostgreSQL sets the transaction-local setting
+zoiko.audit_purge=on, which the trigger function honours for DELETE only;
+SQLite uses a one-row flag table. UPDATE is never allowed. Today the only
+caller is the Super Admin organisation hard-delete; retention purges will use
+it once D-2 / D-3 are decided. Whether hard-delete may purge audit rows at all
+is a Security / counsel decision (sign-off packet 03).
+"""
+
+import logging
+from contextlib import contextmanager
+
+from sqlalchemy import event, inspect, text
+
+logger = logging.getLogger("zoiko_payroll.audit_immutability")
+
+AUDIT_TABLES = (
+    "payroll_tax_configuration_audit",
+    "assisted_access_audit_events",
+    "payroll_personal_data_access_events",
+    "auth_audit_events",
+)
+_SQLITE_FLAG = "zoiko_audit_purge_flag"
+
+
+def install_sqlite_triggers(connection) -> None:
+    connection.execute(text(f"CREATE TABLE IF NOT EXISTS {_SQLITE_FLAG} (reason TEXT)"))
+    have = set(inspect(connection).get_table_names())
+    for table in AUDIT_TABLES:
+        if table not in have:
+            continue
+        connection.execute(text(
+            f"CREATE TRIGGER IF NOT EXISTS {table}_no_update BEFORE UPDATE ON {table} "
+            f"BEGIN SELECT RAISE(ABORT, 'audit rows are append-only ({table})'); END"))
+        connection.execute(text(
+            f"CREATE TRIGGER IF NOT EXISTS {table}_no_delete BEFORE DELETE ON {table} "
+            f"WHEN (SELECT count(*) FROM {_SQLITE_FLAG}) = 0 "
+            f"BEGIN SELECT RAISE(ABORT, 'audit rows are append-only ({table})'); END"))
+
+
+def register(metadata) -> None:
+    @event.listens_for(metadata, "after_create")
+    def _after_create(target, connection, **kw):
+        if connection.dialect.name == "sqlite":
+            install_sqlite_triggers(connection)
+
+
+@contextmanager
+def audit_purge_scope(db, reason: str):
+    """Allow DELETE (never UPDATE) of audit rows inside this block only."""
+    dialect = db.get_bind().dialect.name
+    logger.warning("[audit] purge scope opened: %s", reason)
+    if dialect == "postgresql":
+        db.execute(text("SELECT set_config('zoiko.audit_purge', 'on', true)"))
+        try:
+            yield
+        finally:
+            db.execute(text("SELECT set_config('zoiko.audit_purge', 'off', true)"))
+    elif dialect == "sqlite":
+        db.execute(text(f"CREATE TABLE IF NOT EXISTS {_SQLITE_FLAG} (reason TEXT)"))
+        db.execute(text(f"INSERT INTO {_SQLITE_FLAG} (reason) VALUES (:r)"), {"r": reason[:200]})
+        try:
+            yield
+        finally:
+            db.execute(text(f"DELETE FROM {_SQLITE_FLAG}"))
+    else:
+        yield
diff --git a/backend/app/modules/auth/audit.py b/backend/app/modules/auth/audit.py
new file mode 100644
index 0000000..db41d8d
--- /dev/null
+++ b/backend/app/modules/auth/audit.py
@@ -0,0 +1,54 @@
+"""G5 F-5: write one auth_audit_events row per authentication event.
+
+`required=True` (successful login / refresh): if the row cannot be written the
+caller refuses the request (503) - no session without an audit record.
+Otherwise (failures, logout, reset): best effort, logged on error."""
+
+import hashlib
+import logging
+
+from sqlalchemy.orm import Session
+
+from app.core.exceptions import ZoikoException
+
+logger = logging.getLogger("zoiko_payroll.auth.audit")
+
+LOGIN_SUCCESS = "LOGIN_SUCCESS"
+LOGIN_FAILED = "LOGIN_FAILED"
+ACCOUNT_INACTIVE = "ACCOUNT_INACTIVE"
+REFRESH = "REFRESH"
+REFRESH_FAILED = "REFRESH_FAILED"
+LOGOUT = "LOGOUT"
+PASSWORD_RESET_REQUESTED = "PASSWORD_RESET_REQUESTED"
+PASSWORD_RESET = "PASSWORD_RESET"
+INVITATION_ACCEPTED = "INVITATION_ACCEPTED"
+
+
+def email_sha256(email) -> str:
+    return hashlib.sha256((email or "").strip().lower().encode("utf-8")).hexdigest()
+
+
+def record(db: Session, event_type: str, *, user=None, email=None, request=None, reason=None,
+           required: bool = False) -> None:
+    from app.modules.auth.models import AuthAuditEvent
+
+    audit_db = Session(bind=db.get_bind())
+    try:
+        audit_db.add(AuthAuditEvent(
+            event_type=event_type,
+            user_id=getattr(user, "id", None),
+            organization_id=getattr(user, "organization_id", None),
+            email_sha256=email_sha256(email) if (email and user is None) else None,
+            reason=(reason or None) and str(reason)[:80],
+            client_address=(getattr(getattr(request, "client", None), "host", None) or None),
+            user_agent=(request.headers.get("user-agent", "")[:300] or None) if request is not None else None,
+        ))
+        audit_db.commit()
+    except Exception:  # noqa: BLE001
+        audit_db.rollback()
+        logger.exception("[auth-audit] could not record %s", event_type)
+        if required:
+            raise ZoikoException(503, "AUTH_AUDIT_UNAVAILABLE",
+                                 "Sign-in is temporarily unavailable: the audit record could not be written.")
+    finally:
+        audit_db.close()
diff --git a/backend/alembic/versions/d1e5a7c3b9f2_auth_audit_and_immutable_audit_rows.py b/backend/alembic/versions/d1e5a7c3b9f2_auth_audit_and_immutable_audit_rows.py
new file mode 100644
index 0000000..42502eb
--- /dev/null
+++ b/backend/alembic/versions/d1e5a7c3b9f2_auth_audit_and_immutable_audit_rows.py
@@ -0,0 +1,66 @@
+"""auth audit events (G5 F-5) and append-only audit tables (G5 F-6)
+
+Revision ID: d1e5a7c3b9f2
+Revises: 8b14824fb575
+Create Date: 2026-10-14
+
+Additive: one new table, one function, two triggers per audit table. No
+existing row is read or rewritten. CREATE TRIGGER takes SHARE ROW EXCLUSIVE on
+each audit table briefly (blocks writes to that table for the DDL only).
+"""
+
+import sqlalchemy as sa
+from alembic import op
+
+revision = "d1e5a7c3b9f2"
+down_revision = "8b14824fb575"
+branch_labels = None
+depends_on = None
+
+AUDIT_TABLES = ("payroll_tax_configuration_audit", "assisted_access_audit_events",
+                "payroll_personal_data_access_events", "auth_audit_events")
+
+
+def upgrade() -> None:
+    op.create_table(
+        "auth_audit_events",
+        sa.Column("id", sa.Integer(), primary_key=True),
+        sa.Column("occurred_at", sa.DateTime(), nullable=False),
+        sa.Column("event_type", sa.String(40), nullable=False),
+        sa.Column("user_id", sa.Integer(), sa.ForeignKey("users.id"), nullable=True),
+        sa.Column("organization_id", sa.Integer(), nullable=True),
+        sa.Column("email_sha256", sa.String(64), nullable=True),
+        sa.Column("reason", sa.String(80), nullable=True),
+        sa.Column("client_address", sa.String(64), nullable=True),
+        sa.Column("user_agent", sa.String(300), nullable=True),
+    )
+    for col in ("id", "occurred_at", "event_type", "user_id", "organization_id"):
+        op.create_index(f"ix_auth_audit_events_{col}", "auth_audit_events", [col])
+
+    if op.get_bind().dialect.name != "postgresql":
+        return
+    op.execute("""
+        CREATE OR REPLACE FUNCTION zoiko_reject_audit_mutation() RETURNS trigger
+        LANGUAGE plpgsql AS $$
+        BEGIN
+            IF TG_OP = 'DELETE' AND current_setting('zoiko.audit_purge', true) = 'on' THEN
+                RETURN OLD;
+            END IF;
+            RAISE EXCEPTION 'audit rows are append-only (%: % refused)', TG_TABLE_NAME, TG_OP
+                USING ERRCODE = 'insufficient_privilege';
+        END;
+        $$
+    """)
+    for t in AUDIT_TABLES:
+        op.execute(f"CREATE TRIGGER {t}_append_only BEFORE UPDATE OR DELETE ON {t} "
+                   f"FOR EACH ROW EXECUTE FUNCTION zoiko_reject_audit_mutation()")
+
+
+def downgrade() -> None:
+    if op.get_bind().dialect.name == "postgresql":
+        for t in AUDIT_TABLES:
+            op.execute(f"DROP TRIGGER IF EXISTS {t}_append_only ON {t}")
+        op.execute("DROP FUNCTION IF EXISTS zoiko_reject_audit_mutation()")
+    for col in ("organization_id", "user_id", "event_type", "occurred_at", "id"):
+        op.drop_index(f"ix_auth_audit_events_{col}", table_name="auth_audit_events")
+    op.drop_table("auth_audit_events")
